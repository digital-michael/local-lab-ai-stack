# Editor and OS
*.swp
*.swo
*~
.vscode/
.idea/
.DS_Store
Thumbs.db

# Per-machine VS Code multi-root workspace — folder paths are workstation-specific
*.code-workspace

# Secrets and credentials — never commit
*.key
*.pem
*.crt
*.env
secrets/
configs/credentials.local

# Python
__pycache__/
*.pyc
*.pyo

# Runtime and temp
*.log
*.pid
testing/layer5_distributed/results/

# Machine-local node profile override (not committed; set by configure.sh recommend)
configs/node_profile

# Live runtime config — moved to $AI_STACK_DIR/configs/config.json (2026-07-14) so that
# git operations (pull/checkout/stash) on this repo can never touch live settings.
# configs/config.json.example is the tracked bootstrap template (see `configure.sh init`).
configs/config.json

# Generated artifacts — point-in-time playbooks and other output files
# Never committed; lives only on the local machine that generated them
output/

# Live Traefik middleware with injected API key — secret value, never commit
configs/traefik/dynamic/ki-auth.yaml

# Meta framework (collaboration protocol — separate repo, symlinked locally)
docs/meta
docs/meta_local/dynamics.md
docs/meta_local/review_log.md
docs/meta_local/agent-context.md
